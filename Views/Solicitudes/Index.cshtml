@model IEnumerable<TecnoGasPortal.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Solicitudes de Servicio";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-list-check"></i> Solicitudes de Servicio Técnico
    </h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="bi bi-plus-circle"></i> Nueva Solicitud
    </a>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay solicitudes registradas aún.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Distrito</th>
                        <th>Tipo de Servicio</th>
                        <th>Descripción</th>
                        <th>Fecha de Registro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Cliente</td>
                            <td>@item.Telefono</td>
                            <td>@item.Distrito</td>
                            <td>
                                <span class="badge bg-info text-dark">@item.TipoServicio</span>
                            </td>
                            <td>@(item.Descripcion ?? "—")</td>
                            <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
